{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unfortunatelyalex.github.io/ventoy-depot-registry/schema/provider-v1.schema.json",
  "title": "Ventoy Depot declarative provider",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provider_id", "display_name", "homepage_url", "driver", "allowed_hosts", "capabilities", "release_sources", "detection"],
  "properties": {
    "schema_version": {"const": 1},
    "provider_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
    "display_name": {"type": "string", "minLength": 2, "maxLength": 80},
    "homepage_url": {"$ref": "#/$defs/httpsUrl"},
    "driver": {"enum": ["github-releases", "gitlab-releases", "static-json", "directory-index", "checksum-list", "sidecar", "static-html", "latest-redirect"]},
    "allowed_hosts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9.-]+$"}},
    "capabilities": {"$ref": "#/$defs/capabilities"},
    "release_sources": {"type": "array", "minItems": 1, "maxItems": 40, "items": {"$ref": "#/$defs/releaseSource"}},
    "detection": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"$ref": "#/$defs/detectionRule"}},
    "notes": {"type": "array", "items": {"type": "string", "maxLength": 500}}
  },
  "$defs": {
    "httpsUrl": {"type": "string", "pattern": "^https://"},
    "stringSet": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 80}},
    "capabilities": {
      "type": "object", "additionalProperties": false,
      "required": ["products", "editions", "flavors", "architectures", "languages", "channels"],
      "properties": {
        "products": {"$ref": "#/$defs/stringSet"}, "editions": {"$ref": "#/$defs/stringSet"},
        "flavors": {"$ref": "#/$defs/stringSet"}, "architectures": {"$ref": "#/$defs/stringSet"},
        "languages": {"$ref": "#/$defs/stringSet"}, "channels": {"$ref": "#/$defs/stringSet"}
      }
    },
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["product_id", "channel", "architecture"],
      "properties": {
        "product_id": {"type": "string"}, "edition": {"type": ["string", "null"]}, "flavor": {"type": ["string", "null"]},
        "channel": {"type": "string"}, "architecture": {"type": "string"}, "language": {"type": ["string", "null"]},
        "version": {"type": ["string", "null"]}, "build": {"type": ["string", "null"]}
      }
    },
    "checksum": {
      "type": "object", "additionalProperties": false, "required": ["algorithm", "strategy"],
      "properties": {
        "algorithm": {"enum": ["sha256", "sha512"]}, "strategy": {"enum": ["checksum-list", "sidecar", "release-asset", "release-digest", "embedded-json", "html-table"]},
        "url_template": {"$ref": "#/$defs/httpsUrl"}, "suffix": {"type": "string", "maxLength": 32}, "entry_regex": {"type": "string", "maxLength": 512}
      }
    },
    "signature": {
      "type": "object", "additionalProperties": false, "required": ["strategy", "signer_fingerprints"],
      "properties": {
        "strategy": {"enum": ["sidecar", "signed-checksum-list"]}, "url_template": {"$ref": "#/$defs/httpsUrl"},
        "suffix": {"type": "string", "maxLength": 32}, "signer_fingerprints": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(?:[A-Fa-f0-9]{40}|[A-Fa-f0-9]{64})$"}}
      }
    },
    "download": {
      "type": "object", "additionalProperties": false, "required": ["strategy"],
      "properties": {"strategy": {"enum": ["url-template", "page-link", "release-asset", "latest-redirect", "user-supplied"]}, "url_template": {"$ref": "#/$defs/httpsUrl"}, "link_regex": {"type": "string", "maxLength": 512}}
    },
    "releaseSource": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "metadata_url", "artifact_regex", "identity", "download", "verification"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"}, "metadata_url": {"$ref": "#/$defs/httpsUrl"},
        "artifact_regex": {"type": "string", "maxLength": 512}, "identity": {"$ref": "#/$defs/identity"}, "download": {"$ref": "#/$defs/download"},
        "verification": {"type": "object", "additionalProperties": false, "required": ["level", "checksum"], "properties": {"level": {"enum": ["CHECKSUM", "SIGNED"]}, "checksum": {"$ref": "#/$defs/checksum"}, "signature": {"$ref": "#/$defs/signature"}}},
        "automatic_download": {"type": "boolean", "default": true}
      }
    },
    "detectionRule": {
      "type": "object", "additionalProperties": false, "required": ["regex", "identity", "downloadable"],
      "properties": {"regex": {"type": "string", "maxLength": 512}, "identity": {"$ref": "#/$defs/identity"}, "downloadable": {"type": "boolean"}}
    }
  }
}
