{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ventoy-depot.invalid/schema/provider-v1.schema.json",
  "title": "Ventoy Depot declarative provider",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provider_id", "driver", "allowed_hosts", "detection"],
  "properties": {
    "schema_version": {"const": 1},
    "provider_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
    "driver": {
      "enum": ["github-releases", "gitlab-releases", "static-json", "directory-index", "checksum-list", "sidecar", "static-html", "latest-redirect"]
    },
    "allowed_hosts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "format": "hostname"}
    },
    "metadata_url": {"type": "string", "pattern": "^https://"},
    "checksum_algorithm": {"enum": ["sha256", "sha512"]},
    "signer_fingerprints": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[A-Fa-f0-9]{40,64}$"}
    },
    "detection": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["regex"],
        "properties": {"regex": {"type": "string", "maxLength": 512}}
      }
    }
  }
}
